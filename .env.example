# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VERCEL KV / UPSTASH REDIS (Opsional untuk Deploy di Vercel):
# Jika diisi, data inventaris SIM-GA akan otomatis tersimpan permanen di cloud Vercel KV.
# Di Vercel Dashboard: Buka tab Storage -> Create KV -> Connect to Project.
# Vercel akan otomatis menyuntikkan variabel berikut:
KV_REST_API_URL="https://example-kv.upstash.io"
KV_REST_API_TOKEN="example_token"

# Atau jika menggunakan Upstash Redis langsung:
# UPSTASH_REDIS_REST_URL="https://example-kv.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="example_token"
